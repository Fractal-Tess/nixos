#!/usr/bin/env fish
# dotfiles — Apply or inspect desktop dotfiles via GNU stow
#
# Rewrite of apply-desktop-dotfiles (bash). Applies host-specific
# waybar and monitor configs, stows the desktop package, and fixes
# the hypranimations.lua chained symlink.
#
# Dependencies: stow, hostname
# Usage: dotfiles [apply|status] [--help|-h]

set repo_dir (set -q REPO_DIR; and echo $REPO_DIR; or echo $HOME/nixos)
set stow_dir $repo_dir/dotfiles
set target_home $HOME
set host_name (set -q HOSTNAME_VALUE; and echo $HOSTNAME_VALUE; or hostname)

function show_help
    echo "Usage: dotfiles <subcommand>"
    echo ""
    echo "Subcommands:"
    echo "  apply   Apply desktop dotfiles using GNU stow"
    echo "  status  Show what would be linked (stow dry-run)"
    echo ""
    echo "Options:"
    echo "  --help, -h  Show this help message"
    echo ""
    echo "Repo dir  : $repo_dir"
    echo "Stow dir  : $stow_dir"
    echo "Target    : $target_home"
    echo "Hostname  : $host_name"
end

function ensure_dirs
    mkdir -p \
        $target_home/.config/hypr/conf.d \
        $target_home/.config/waybar \
        $target_home/.local/share/wallpapers/library \
        $target_home/.config/colors \
        $target_home/.config/RofiScripts/WallpaperChanger \
        $target_home/.config/hypr/hyprconfigs \
        $target_home/.config/xfce4/xfconf/xfce-perchannel-xml \
        $target_home/.config/cava/themes \
        $target_home/.config/btop/themes \
        $target_home/.config/qt5ct/colors \
        $target_home/.config/qt6ct/colors \
        $target_home/.config/gtk-3.0 \
        $target_home/.config/gtk-4.0
end

function resolve_host_configs
    switch $host_name
        case kiwi
            set -g waybar_config config-kiwi.jsonc
            set -g monitor_config monitors-kiwi.lua
        case neo
            set -g waybar_config config-neo.jsonc
            set -g monitor_config monitors-neo.lua
        case '*'
            set -g waybar_config config-vd.jsonc
            set -g monitor_config monitors-vd.lua
    end
end

function clean_stale_hyprland_files
    # Remove obsolete hyprlang files and links left behind by the Lua migration.
    rm -f \
        $target_home/.config/hypr/hyprland.conf \
        $target_home/.config/colors/hyprcolors.conf \
        $target_home/.config/matugen/templates/hyprcolors.conf \
        $target_home/.config/hypr/conf.d/monitors.conf \
        $target_home/.config/hypr/conf.d/monitors.lua \
        $target_home/.config/hypr/conf.d/monitors-kiwi.conf \
        $target_home/.config/hypr/conf.d/monitors-neo.conf \
        $target_home/.config/hypr/conf.d/monitors-vd.conf \
        $target_home/.config/RofiScripts/Animations/Horizontal/hypranimations.conf \
        $target_home/.config/RofiScripts/Animations/Vertical/hypranimations.conf \
        $target_home/.config/RofiScripts/Rounding/RoundingThemes/0px/hyprdecoration.conf \
        $target_home/.config/RofiScripts/Rounding/RoundingThemes/10px/hyprdecoration.conf \
        $target_home/.config/RofiScripts/Rounding/RoundingThemes/20px/hyprdecoration.conf \
        $target_home/.config/hypr/hyprconfigs/hypranimations.conf \
        $target_home/.config/hypr/hyprconfigs/hypranimations.lua \
        $target_home/.config/hypr/hyprconfigs/hyprautostart.conf \
        $target_home/.config/hypr/hyprconfigs/hyprdecoration.conf \
        $target_home/.config/hypr/hyprconfigs/hyprenvironment.conf \
        $target_home/.config/hypr/hyprconfigs/hyprinput.conf \
        $target_home/.config/hypr/hyprconfigs/hyprkeybinds.conf \
        $target_home/.config/hypr/hyprconfigs/hyprlookandfeel.conf \
        $target_home/.config/hypr/hyprconfigs/hyprpermissions.conf \
        $target_home/.config/hypr/hyprconfigs/hyprplugins.conf \
        $target_home/.config/hypr/hyprconfigs/hyprprograms.conf \
        $target_home/.config/hypr/hyprconfigs/hyprwindowsandworkspaces.conf
end

function cmd_apply
    ensure_dirs
    resolve_host_configs
    clean_stale_hyprland_files

    # Zellij owns and rewrites its live config, so do not replace it with a Stow link.
    # monitors.lua and hypranimations.lua are linked explicitly below, so keep them
    # out of stow's hands — the rofi switcher scripts can turn the in-repo copies
    # into absolute symlinks, which makes stow abort the whole package.
    stow --dir $stow_dir --target $target_home --restow \
        --ignore=zellij \
        --ignore=monitors.lua \
        --ignore=hypranimations.lua \
        desktop
        or return 1

    # Keep these links relative so stow can manage the directory cleanly.
    ln -sfn $waybar_config $target_home/.config/waybar/config.jsonc
    ln -sfn $monitor_config $target_home/.config/hypr/conf.d/monitors.lua

    # Fix hypranimations.lua — stow can't resolve the chained relative symlink,
    # so replace it with a direct link to the RofiScripts animation config.
    ln -sfn $target_home/.config/RofiScripts/Animations/Horizontal/hypranimations.lua \
        $target_home/.config/hypr/hyprconfigs/hypranimations.lua

    if test -x $repo_dir/scripts/wallpaper/sync-library.sh
        $repo_dir/scripts/wallpaper/sync-library.sh
    end
end

function cmd_status
    resolve_host_configs
    echo "Host    : $host_name"
    echo "Waybar  : $waybar_config"
    echo "Monitor : $monitor_config"
    echo ""
    # Host-specific monitor and animation links are managed by cmd_apply above.
    stow --dir $stow_dir --target $target_home --restow --no \
        --ignore=zellij \
        --ignore=monitors.lua \
        --ignore=hypranimations.lua \
        desktop
end

# Argument dispatch
set subcommand $argv[1]

switch $subcommand
    case --help -h
        show_help
    case apply
        cmd_apply
    case status
        cmd_status
    case ''
        show_help
        exit 1
    case '*'
        echo "dotfiles: unknown subcommand '$subcommand'" >&2
        echo "Run 'dotfiles --help' for usage." >&2
        exit 1
end
