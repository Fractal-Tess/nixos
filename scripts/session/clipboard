#!/usr/bin/env fish
# clipboard — Open the clip-sync keyboard-first history switcher.
#
# Rollback during the initial soak:
#   systemctl --user stop clip-sync
#   git restore dotfiles/desktop/.config/hypr/hyprconfigs/hyprautostart.conf \
#     scripts/session/clipboard
#   ~/nixos/scripts/system/dotfiles apply

function _clipboard_help
    echo "clipboard — clip-sync history switcher"
    echo ""
    echo "Usage: clipboard [--help]"
    echo ""
    echo "Opens the singleton clip-sync switcher. The daemon is started through"
    echo "the systemd user service when necessary."
end

if contains -- --help $argv; or contains -- -h $argv
    _clipboard_help
    exit 0
end

exec /run/current-system/sw/bin/clip-sync ui switcher
