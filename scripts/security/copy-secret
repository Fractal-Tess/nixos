#!/usr/bin/env fish
# copy-secret — decrypt a SOPS secret from ~/nixos/secrets and copy it to the clipboard.
#
# Usage:
#   copy-secret                interactive fzf picker over all secrets
#   copy-secret <name>         copy by unique key-name match
#   copy-secret <file>:<key>   copy a specific secret (e.g. opencode.json:vgfractal)
#
# The value is only ever written to the clipboard, never printed.

# Script root (secrets dir is $root/secrets). Global so functions can see it.
# Script lives at $root/scripts/security/copy-secret → three dirnames up.
set -g root (dirname (dirname (dirname (status filename))))

function _entries
    for f in $root/secrets/*.json
        set -l name (string replace -r '\.json$' '' (basename $f))
        for key in (jq -r 'keys | map(select(. != "sops")) | .[]' $f)
            echo "$name:$key"
        end
    end
end

function _copy
    set -l file $argv[1]
    set -l key $argv[2]

    command -q wl-copy; or begin
        echo "copy-secret: wl-copy not available (no Wayland session?)" >&2
        return 1
    end

    set -l val (sops -d "$root/secrets/$file.json" 2>/dev/null | jq -r --arg k "$key" '.[$k]')
    if test -z "$val"; or test "$val" = "null"
        echo "copy-secret: failed to decrypt $file:$key" >&2
        return 1
    end

    printf %s "$val" | wl-copy
    notify-send -a copy-secret "Secret copied" "$file:$key" 2>/dev/null
    echo "copied $file:$key"
end

set -l entries (_entries)

if set -q argv[1]
    # Normalize `file.json:key` → `file:key` (entries omit the extension).
    set -l needle (string replace -r '\.json:' ':' $argv[1])
    set -l matches
    for e in $entries
        if string match -q -- "*$needle*" $e
            set -a matches $e
        end
    end

    switch (count $matches)
        case 0
            echo "copy-secret: no secret matches '$needle'" >&2
            echo "available:" >&2
            for e in $entries
                echo "  $e" >&2
            end
            exit 1
        case 1
            _copy (string split ':' $matches[1])
        case '*'
            set -l pick (printf '%s\n' $matches | fzf --prompt="select secret: ")
            test -z "$pick"; and exit 1
            _copy (string split ':' $pick)
    end
else
    set -l pick (printf '%s\n' $entries | fzf --prompt="select secret: ")
    test -z "$pick"; and exit 1
    _copy (string split ':' $pick)
end
